# =============================================================
# .env.example — Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to GitHub — it contains secrets.
# Add .env to your .gitignore file.
#
# On Render, set these in:
#   Dashboard → Your Service → Environment → Add Environment Variable
# =============================================================

# ---------------------------
# Database (Supabase)
# ---------------------------
# Found in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "URI" format (starts with postgresql://)
# Tip: use alphanumeric-only passwords to avoid URL parsing issues
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ---------------------------
# Flask
# ---------------------------
# A long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# The admin password she uses to log into the dashboard.
# Keep it simple but not obvious — she'll type this on her phone.
ADMIN_PASSWORD=your-admin-password-here

# ---------------------------
# Gmail (for low-stock notifications)
# ---------------------------
# The Gmail address that sends AND receives the alerts.
# Use the Inklub Gmail account for both.
GMAIL_USER=inklub@gmail.com

# An App Password (NOT your regular Gmail password).
# Generate at: Google Account → Security → 2-Step Verification → App passwords
# Use all alphanumeric characters when creating it to avoid parsing issues.
GMAIL_APP_PASSWORD=your-16-character-app-password

# ---------------------------
# CORS (frontend origin)
# ---------------------------
# Set this to your GitHub Pages URL once deployed.
# Example: https://your-org.github.io
# During local dev, you can leave this as * (allows all origins)
ALLOWED_ORIGIN=*
